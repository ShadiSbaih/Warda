# Mobile App Environment Variables Example (Expo)
# Variables must start with EXPO_PUBLIC_ to be exposed to the client

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Maps & Location (Google Maps / Mapbox)
EXPO_PUBLIC_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Integration (Mock Stripe — no keys needed)
# All payment calls go to EXPO_PUBLIC_API_URL/stripe/*
