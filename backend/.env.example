# Backend Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/warda_gifts

# Authentication
# Use a strong random string of at least 32 characters for JWT_SECRET
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# File Uploads
UPLOAD_MAX_FILE_MB=5

# Payments (COD only — no external keys required)
# Warda uses Cash on Delivery. No Stripe or gateway keys needed.

# Cloudinary / File Storage (optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
